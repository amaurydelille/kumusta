# Edge Function secrets for the Kumusta project. Never commit real values.
#   supabase secrets set --project-ref vpitjvtfzpqfnqgzcpla --env-file supabase/.env

# Lesson generation (Qwen via DashScope international).
DASHSCOPE_API_KEY=replace_me
QWEN_LESSON_MODEL=qwen3.8-max-0902

# Live practice: STT -> Claude -> TTS.
ANTHROPIC_API_KEY=replace_me
# Only for an organization-level Anthropic key.
ANTHROPIC_WORKSPACE_ID=
KUMUSTA_LIVE_LLM_MODEL=claude-opus-5-5
SONIOX_API_KEY=replace_me

# TTS and batch/realtime STT. The key needs text_to_speech and speech_to_text.
ELEVENLABS_API_KEY=replace_me

# Subscriptions.
KUMUSTA_ENTITLEMENT_ID=kumusta_pro
REVENUECAT_WEBHOOK_AUTHORIZATION=replace_with_long_random_value
REVENUECAT_SECRET_API_KEY=replace_me
REVENUECAT_PROJECT_ID=replace_me

# Transactional email (Resend), triggered by pg_cron (supabase/ops).
EMAIL_WORKER_AUTHORIZATION=replace_with_long_random_value
RESEND_API_KEY=replace_me
EMAIL_FROM=Kumusta <hello@example.com>

# Voice budgets. Defaults are applied when omitted.
KUMUSTA_TTS_USER_DAILY_REQUEST_LIMIT=500
KUMUSTA_TTS_PROJECT_DAILY_REQUEST_LIMIT=10000
KUMUSTA_STT_USER_DAILY_REQUEST_LIMIT=300
KUMUSTA_STT_PROJECT_DAILY_REQUEST_LIMIT=8000

# Dev project only. Never enable the bypass in staging/production.
KUMUSTA_ENVIRONMENT=development
KUMUSTA_DEVELOPMENT_BYPASS_ENTITLEMENT=false
