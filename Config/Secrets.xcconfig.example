// Copy to Secrets.xcconfig. This file is gitignored.
// The Supabase publishable key and RevenueCat iOS SDK key are safe client identifiers.
// Provider secrets (ElevenLabs, DashScope/Qwen, Anthropic, Soniox) must only be configured as Supabase Edge Function secrets.
SUPABASE_PROJECT_URL = https:/$()/your-production-project.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_replace_me
REVENUECAT_PUBLIC_SDK_KEY = appl_replace_me
// Debug builds use the RevenueCat Test Store key instead.
REVENUECAT_TEST_STORE_SDK_KEY = test_replace_me
KUMUSTA_ENTITLEMENT_ID = kumusta_pro
APPSFLYER_DEV_KEY = replace_with_appsflyer_dev_key
APPSFLYER_APP_ID = replace_with_apple_app_id
TIKTOK_APP_ID = replace_with_tiktok_app_id
TIKTOK_BUSINESS_APP_ID = replace_with_tiktok_business_app_id
TIKTOK_APP_ACCESS_TOKEN = replace_with_tiktok_app_secret
FACEBOOK_APP_ID = replace_with_meta_app_id
FACEBOOK_CLIENT_TOKEN = replace_with_meta_client_token
POSTHOG_PROJECT_TOKEN = replace_with_posthog_project_token
POSTHOG_HOST = https:/$()/us.i.posthog.com
